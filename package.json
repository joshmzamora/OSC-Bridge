{
  "name": "osc_bridge",
  "version": "1.0.2",
  "description": "A simple app that forwards incoming OSC messages to a static webpage.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main/index.js",
  "scripts": {
    "start": "electron ./main/index",
    "build": "electron-builder build"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "files": "main/**/*",
    "extraResources": [
      {
        "from": "sketch",
        "to": "sketch"
      },
      {
        "from": "receivers",
        "to": "receivers"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "node-osc": "^11.5.0"
  }
}
